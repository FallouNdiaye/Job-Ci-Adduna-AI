#!/bin/sh
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "Génération de l'inventaire technique..."
python3 scripts/generate_technical_docs.py

echo "Génération du changelog Git..."
python3 scripts/generate_changelog.py

echo "Ajout des documents générés à l'index..."
git add docs/INVENTAIRE_TECHNIQUE_AUTOMATIQUE.md CHANGELOG.md

echo "Documentation technique et changelog prêts pour le commit."
