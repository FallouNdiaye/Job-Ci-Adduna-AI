JOBHUNTER_DB=./jobhunter.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# La collecte commence automatiquement au démarrage du backend.
AUTO_SYNC_ENABLED=true
# Fréquence automatique minimale acceptée : 60 minutes (limitation prudente pour respecter les sources publiques).
SYNC_INTERVAL_MINUTES=60
COLLECTOR_HTTP_TIMEOUT=15
# Facultatif : slugs des tableaux de carrières Greenhouse séparés par des virgules.
# Exemple : companyslug,anothercompanyslug
GREENHOUSE_BOARDS=
# Facultatif : slugs d'entreprises Lever séparés par des virgules.
LEVER_SITES=
# IA facultative : secrets uniquement côté backend, jamais dans une variable VITE_*.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional collectors — off by default. Install backend/requirements-collectors.txt first.
# JobSpy (the described scrape_jobs(hours_old=...) API is commonly python-jobspy, not a verified 'jobdrop' package).
JOBSPY_ENABLED=false
JOBSPY_SITES=indeed
JOBSPY_SEARCH_TERMS=full stack developer,mobile developer,Java Spring Boot
JOBSPY_LOCATION=Worldwide
JOBSPY_HOURS_OLD=720
JOBSPY_RESULTS_PER_SOURCE=20
# Hirehunt plugin-based scraper (choose sources actually supported and authorized for your use).
HIREHUNT_ENABLED=false
HIREHUNT_SOURCES=google_careers,amazon,apple,microsoft
HIREHUNT_SEARCH_TERMS=full stack developer,mobile developer,Java Spring Boot
HIREHUNT_LOCATION=Worldwide
HIREHUNT_RESULTS_PER_SOURCE=20
# Optional self-hosted remote-jobs-api service URL, e.g. http://127.0.0.1:8090/jobs
REMOTE_JOBS_API_URL=
# Crawl4AI only visits explicitly listed public URLs and extracts JobPosting JSON-LD.
CRAWL4AI_ENABLED=false
CRAWL4AI_SEED_URLS=
# ScrapeGraphAI Cloud uses the official scrapegraph-py SDK and SGAI_API_KEY; provide public target URLs.
SCRAPEGRAPHAI_ENABLED=false
SGAI_API_KEY=
SCRAPEGRAPHAI_URLS=https://www.senjob.com/,https://www.senejobs.com/,https://senum-jobs.sec.gouv.sn/,https://primature.sn/programmes-speciaux/tabax-senegal,https://www.tabax-consulting.com/fr,https://remotive.com/remote-jobs/software-dev,https://weworkremotely.com/remote-jobs,https://remoteok.com/remote-dev-jobs,https://jobicy.com/jobs-rss-feed

# Collecte automatique des offres doctorales
DOCTORAL_AUTO_SYNC_ENABLED=true
DOCTORAL_SYNC_INTERVAL_HOURS=24
